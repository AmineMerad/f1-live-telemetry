# Copy to .env and fill in. Never commit .env or provider tokens.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal

# OpenF1 — OAuth2 username/password for authenticated access (live sessions
# restrict even historical data to authenticated users; tokens last 1h and are
# refreshed by the client). Empty = anonymous (historical only, off-session).
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_USERNAME=
OPENF1_PASSWORD=

SESSION_ID=
MODEL_VERSION=baseline-v0
PREDICTION_CADENCE_SECONDS=20

API_PORT=8000
